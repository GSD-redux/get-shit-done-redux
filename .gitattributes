# Normalize line endings to LF on checkin; auto-detect binary (skipped).
* text=auto eol=lf
# Common binary types — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary

